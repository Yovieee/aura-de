# Aura Desktop Environment (aura-de) Runtime Configuration
# Reference settings for local nested development. Export values explicitly;
# .env files are not automatically loaded.

# Execution backend: "winit" (nested development).
# Native DRM/KMS availability is listed in docs/implementation-status.md.
AURA_BACKEND=winit

# Default output resolution and scale when running nested under winit
AURA_WINIT_RESOLUTION=1920x1080
AURA_OUTPUT_SCALE=1

# Liquid Glass optical pipeline preset: "ultra", "balanced", or "reduced-transparency"
AURA_GLASS_QUALITY=ultra

# Optional shell-free terminal argv prefix. If unset, a known available terminal is selected.
# Known terminals get their command separator automatically; custom wrappers need one.
# AURA_TERMINAL='foot'
# AURA_TERMINAL='xfce4-terminal --disable-server -x'

# Structured logging filter
RUST_LOG=info,aura_compositor=debug,aura_render=info,aura_shell=info
